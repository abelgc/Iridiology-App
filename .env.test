# Integration test environment — LOCAL SUPABASE ONLY.
#
# src/test/integration-setup.ts refuses to run a single test unless
# NEXT_PUBLIC_SUPABASE_URL matches http://127.0.0.1:54321. Production is
# oxaiiawgklmltonuglqw and must never appear in this file.
#
# The keys below are the Supabase CLI's fixed local development keys. They are identical on
# every machine that runs `npx supabase start`, they are printed by that command, and they
# are documented publicly by Supabase. They are not secrets. Recreate this file at any time
# with `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

INTERNAL_TRIGGER_SECRET=test
CRON_SECRET=test

# DELIBERATELY ABSENT: ANTHROPIC_API_KEY, OPENAI_API_KEY, RESEND_API_KEY.
# If a mock ever escapes, the call must fail loudly on a missing key rather than quietly
# spend money. integration-setup.ts throws if any of them is set in the environment.
